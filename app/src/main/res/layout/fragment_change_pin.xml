<?xml version="1.0" encoding="utf-8"?>
<!-- New PIN inside the Cards tab: the student types it twice on the keypad; the old PIN isn't needed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/visitor_panel_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.fragment.pin.ChangePinFragment">

    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/card_details_text_color"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_pin_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_color_hint"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/ll_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal" />

    <GridLayout
        android:id="@+id/gl_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="3" />

    <TextView
        android:id="@+id/tv_result"
        style="@style/CardFormResult" />

    <Button
        android:id="@+id/btn_save"
        style="@style/CardFormButton"
        android:text="@string/pin_save" />
</LinearLayout>

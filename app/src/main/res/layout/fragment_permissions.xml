<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background_color"
    android:orientation="vertical"
    tools:context=".ui.fragment.permission.PermissionsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/main_blue_color"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/permissions_title"
            android:textColor="@color/white"
            android:textSize="@dimen/header_main_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btn_tab_issued"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/permissions_tab_issued"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_tab_new"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/permissions_tab_new"
            android:textAllCaps="false"
            android:textSize="16sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_permissions"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="70dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Issued: permissions still usable on the chosen day; used and expired ones are on the dashboard. -->
            <LinearLayout
                android:id="@+id/ll_issued"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_day"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:drawableStart="@drawable/outline_calendar_24"
                        android:drawablePadding="10dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="8dp"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_today"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permissions_today"
                        android:textAllCaps="false"
                        android:textColor="@color/main_green_color" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_issued_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textColor="@color/text_color_hint"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_permission_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- New permission: tap the student's card, then the form is revealed. -->
            <LinearLayout
                android:id="@+id/ll_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/visitor_panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_tap_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="160dp"
                    android:gravity="center"
                    android:text="@string/permissions_tap_card"
                    android:textColor="@color/card_details_text_color"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/ll_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/PermissionLabel"
                        android:text="@string/permissions_student" />

                    <TextView
                        android:id="@+id/tv_student_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_student_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color_hint"
                        android:textSize="14sp" />

                    <!-- Hidden when the card can't get a permission (not active). -->
                    <LinearLayout
                        android:id="@+id/ll_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/PermissionLabel"
                            android:layout_marginTop="16dp"
                            android:text="@string/permissions_type" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/ll_types"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            style="@style/PermissionLabel"
                            android:layout_marginTop="16dp"
                            android:text="@string/permissions_leaves" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_start_date"
                                style="@style/PermissionPicker"
                                android:layout_weight="3" />

                            <Button
                                android:id="@+id/btn_start_time"
                                style="@style/PermissionPicker"
                                android:layout_marginStart="8dp"
                                android:layout_weight="2" />
                        </LinearLayout>

                        <TextView
                            style="@style/PermissionLabel"
                            android:layout_marginTop="12dp"
                            android:text="@string/permissions_returns" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_end_date"
                                style="@style/PermissionPicker"
                                android:layout_weight="3" />

                            <Button
                                android:id="@+id/btn_end_time"
                                style="@style/PermissionPicker"
                                android:layout_marginStart="8dp"
                                android:layout_weight="2" />
                        </LinearLayout>

                        <!-- Quick lengths: set Back by from Leaves. -->
                        <LinearLayout
                            android:id="@+id/ll_durations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />

                        <TextView
                            style="@style/PermissionLabel"
                            android:layout_marginTop="16dp"
                            android:text="@string/permissions_reason" />

                        <EditText
                            android:id="@+id/et_reason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/edittextstyle"
                            android:gravity="top"
                            android:hint="@string/permissions_reason_hint"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minLines="2"
                            android:padding="12dp"
                            android:textColor="@color/card_details_text_color"
                            android:textColorHint="@color/text_color_hint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_form_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#C62828"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_issue"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/main_green_color"
                        android:text="@string/permissions_issue"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_cancel"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permissions_cancel"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

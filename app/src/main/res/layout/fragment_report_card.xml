<?xml version="1.0" encoding="utf-8"?>
<!-- Block card inside the Cards tab: pick why, then block. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/visitor_panel_background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.fragment.issue.ReportCardFragment">

    <LinearLayout
        android:id="@+id/ll_block_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/CardFormLabel"
            android:layout_marginTop="0dp"
            android:text="@string/block_reason" />

        <LinearLayout
            android:id="@+id/ll_reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/block_note"
            android:textColor="@color/text_color_hint"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_result"
        style="@style/CardFormResult" />

    <Button
        android:id="@+id/btn_report"
        style="@style/CardFormButton"
        android:text="@string/block_button" />
</LinearLayout>

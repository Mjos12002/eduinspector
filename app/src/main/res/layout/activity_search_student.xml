<?xml version="1.0" encoding="utf-8"?>
<!-- The signed-in role's screens above a standard icon-only bottom navigation bar (56dp); the bar hides while the keyboard is open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_search_student"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".SearchStudentActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/content_search_student" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:theme="@style/Theme.Material3.Light.NoActionBar"
        android:background="@color/white"
        android:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:itemActiveIndicatorStyle="@style/BottomNavIndicator"
        android:minHeight="56dp"
        app:itemPaddingTop="12dp"
        app:itemPaddingBottom="12dp"
        app:labelVisibilityMode="unlabeled" />
</LinearLayout>

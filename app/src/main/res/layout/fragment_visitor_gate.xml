<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background_color"
    android:orientation="vertical"
    tools:context=".ui.fragment.visitor.VisitorGateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/main_blue_color"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/visitor_gate_title"
            android:textColor="@color/white"
            android:textSize="@dimen/header_main_title" />

        <TextView
            android:id="@+id/tv_screen_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/visitor_gate_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_mode_gate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/visitor_mode_gate"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_mode_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/visitor_mode_register"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_mode_attach"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/visitor_mode_attach"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Gate: arrivals and departures are separate tabs. -->
    <LinearLayout
        android:id="@+id/ll_directions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btn_check_in"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/visitor_tab_check_in"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_check_out"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/visitor_tab_check_out"
            android:textAllCaps="false"
            android:textSize="16sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_visitor"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="70dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Gate mode: the result of the last tap. -->
            <LinearLayout
                android:id="@+id/ll_gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/visitor_panel_background"
                    android:minHeight="220dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_result_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/visitor_tap_prompt"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tv_result_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/visitor_tap_hint"
                        android:textColor="@color/text_color_hint"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_student_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/visitor_student_label"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color_hint"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_student_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="20sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_visitors_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/visitor_choose_label"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color_hint"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- One checkbox per authorized visitor. -->
                    <LinearLayout
                        android:id="@+id/ll_visitors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_record_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#C62828"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_record"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/main_green_color"
                        android:text="@string/visitor_confirm"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Attach mode: find the virtual card, then tap the blank physical card. -->
            <LinearLayout
                android:id="@+id/ll_attach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_card_search"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittextstyle"
                        android:hint="@string/visitor_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/card_details_text_color"
                        android:textColorHint="@color/text_color_hint"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_card_search"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/visitor_search"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_attach_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/visitor_attach_hint"
                    android:textColor="@color/text_color_hint"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_search_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_color_hint"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/ll_selected_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/visitor_panel_background"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_attach_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/visitor_attach_prompt"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_attach_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_attach_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_attach_done"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/visitor_attach_another"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Whose card a tapped chip is. -->
                <LinearLayout
                    android:id="@+id/ll_card_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/visitor_panel_background"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_card_info_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_card_info_visitor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_card_info_students"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Register visitor: tap the student's card, then add a person allowed to visit them. -->
            <LinearLayout
                android:id="@+id/ll_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/visitor_panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_register_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="160dp"
                    android:text="@string/permissions_tap_card"
                    android:textColor="@color/card_details_text_color"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/ll_register_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/PermissionLabel"
                        android:text="@string/permissions_student" />

                    <TextView
                        android:id="@+id/tv_register_student"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_register_student_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color_hint"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/PermissionLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/visitor_register_existing" />

                    <TextView
                        android:id="@+id/tv_register_visitors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/PermissionLabel"
                        android:layout_marginTop="18dp"
                        android:text="@string/visitor_register_name" />

                    <EditText
                        android:id="@+id/et_visitor_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittextstyle"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/card_details_text_color"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/PermissionLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/visitor_register_phone" />

                    <EditText
                        android:id="@+id/et_visitor_phone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittextstyle"
                        android:hint="@string/visitor_register_phone_hint"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/card_details_text_color"
                        android:textColorHint="@color/text_color_hint"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/PermissionLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/visitor_register_relationship" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ll_relationships"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tv_register_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#C62828"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_register_save"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/main_green_color"
                        android:text="@string/visitor_register_save"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_register_cancel"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permissions_cancel"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

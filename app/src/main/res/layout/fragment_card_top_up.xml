<?xml version="1.0" encoding="utf-8"?>
<!-- Top up form inside the Cards tab; the student is shown above it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/visitor_panel_background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.fragment.topup.CardTopUpFragment">

    <TextView
        style="@style/CardFormLabel"
        android:layout_marginTop="0dp"
        android:text="@string/topup_wallet" />

    <LinearLayout
        android:id="@+id/ll_wallets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/CardFormLabel"
        android:text="@string/topup_pay_with" />

    <LinearLayout
        android:id="@+id/ll_payment_types"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/CardFormLabel"
        android:text="@string/topup_phone" />

    <EditText
        android:id="@+id/et_phone_number"
        style="@style/CardFormField"
        android:hint="@string/topup_phone_hint"
        android:importantForAutofill="no"
        android:inputType="phone" />

    <TextView
        style="@style/CardFormLabel"
        android:text="@string/topup_amount" />

    <EditText
        android:id="@+id/et_amount"
        style="@style/CardFormField"
        android:hint="@string/topup_amount_hint"
        android:importantForAutofill="no"
        android:inputType="number" />

    <TextView
        android:id="@+id/tv_result"
        style="@style/CardFormResult" />

    <Button
        android:id="@+id/btn_topup"
        style="@style/CardFormButton"
        android:text="@string/topup" />
</LinearLayout>
